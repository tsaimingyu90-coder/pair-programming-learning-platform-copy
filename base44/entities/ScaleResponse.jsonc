{
  "name": "ScaleResponse",
  "type": "object",
  "properties": {
    "participant": {
      "type": "string",
      "description": "Reference to Participant ID"
    },
    "survey_type": {
      "type": "string",
      "enum": [
        "pre",
        "post"
      ],
      "description": "\u524d\u6e2c\u6216\u5f8c\u6e2c"
    },
    "part": {
      "type": "string",
      "enum": [
        "anxiety",
        "efficacy",
        "collaboration"
      ],
      "description": "anxiety=\u7b2c\u4e8c\u90e8\u5206 \u7126\u616e\u91cf\u8868, efficacy=\u7b2c\u4e09\u90e8\u5206 \u81ea\u6211\u6548\u80fd\u611f\u91cf\u8868, collaboration=\u7b2c\u56db\u90e8\u5206 \u5354\u4f5c\u5b78\u7fd2\u77e5\u89ba\u91cf\u8868\uff08\u5f8c\u6e2c\u9650\u5b9a\uff09"
    },
    "answers": {
      "type": "object",
      "description": "{ questionIndex: score (1-7) }"
    },
    "total_score": {
      "type": "number",
      "description": "\u7e3d\u5206"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "version_no": {
      "type": "number",
      "description": "Version number: 1 = first attempt, 2 = second, etc.",
      "default": 1
    },
    "is_original": {
      "type": "boolean",
      "description": "True for the first-ever submission (baseline)",
      "default": true
    },
    "is_latest": {
      "type": "boolean",
      "description": "True for the most recent submission",
      "default": true
    },
    "unlocked_by": {
      "type": "string",
      "description": "Email of admin who unlocked this redo"
    },
    "unlocked_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the unlock was performed"
    }
  },
  "required": [
    "participant",
    "survey_type",
    "part"
  ]
}