{
  "name": "TimingSettings",
  "type": "object",
  "properties": {
    "role_swap_interval": {
      "type": "number",
      "description": "Phase0/Phase1 \u89d2\u8272\u5207\u63db\u9593\u9694\u79d2\u6578\uff08\u9810\u8a2d 600\uff09",
      "default": 600
    },
    "auto_prompt_secs": {
      "type": "number",
      "description": "\u4f7f\u7528\u8005\u9592\u7f6e\u5f8c\u81ea\u52d5\u7d66 Gemini \u63d0\u793a\u7684\u79d2\u6578\uff08Navigator \u6a21\u5f0f\uff0c\u9810\u8a2d 150\uff09",
      "default": 150
    },
    "idle_display_text": {
      "type": "string",
      "description": "\u9592\u7f6e\u81ea\u52d5\u63d0\u793a\u986f\u793a\u5728\u5c0d\u8a71\u6846\u7684\u6587\u5b57\uff08\u5b78\u751f\u770b\u5230\u7684\uff09",
      "default": "\uff08\u8acb\u6839\u64da\u5b78\u751f\u76ee\u524d\u9032\u5ea6\uff0c\u53ea\u63d0\u4f9b\u4e00\u500b\u5c0f\u6b65\u9a5f\u7684\u63d0\u793a\u6216\u4e00\u500b\u7c21\u77ed\u554f\u984c\uff0c\u4e0d\u8981\u63d0\u4f9b\u5b8c\u6574\u7a0b\u5f0f\u78bc\u3002\uff09"
    },
    "idle_gemini_text": {
      "type": "string",
      "description": "\u9592\u7f6e\u81ea\u52d5\u63d0\u793a\u5be6\u969b\u50b3\u9001\u7d66 Gemini \u7684\u6587\u5b57",
      "default": "\u5b78\u751f\u66ab\u6642\u6c92\u6709\u52d5\u4f5c\u3002\u8acb\u53ea\u63d0\u4f9b\u4e00\u500b\u5c0f\u6b65\u9a5f\u7684\u63d0\u793a\uff0c\u6216\u63d0\u51fa\u4e00\u500b\u7c21\u77ed\u554f\u984c\u3002\u8acb\u4f7f\u7528\u53f0\u7063\u7e41\u9ad4\u4e2d\u6587\uff0c\u4e0d\u8981\u63d0\u4f9b\u5b8c\u6574\u7a0b\u5f0f\u78bc\uff0c\u4e5f\u4e0d\u8981\u4e00\u6b21\u5b8c\u6210\u6574\u984c\u3002"
    },
    "ctrl_detect_malicious_prompt": {
      "type": "boolean",
      "description": "\u5f8c\u8655\u7406\u958b\u95dc\uff1a\u60e1\u610f\u63d0\u793a\u5075\u6e2c (detectPromptInjection)",
      "default": true
    },
    "ctrl_filter_model_output": {
      "type": "boolean",
      "description": "\u5f8c\u8655\u7406\u958b\u95dc\uff1aAI \u56de\u8986\u904e\u6ffe (sanitizeModelReply)",
      "default": true
    },
    "ctrl_is_full_solution": {
      "type": "boolean",
      "description": "\u5f8c\u8655\u7406\u958b\u95dc\uff1a\u5b8c\u6574\u89e3\u7b54\u5224\u65b7 (looksLikeFullAnswer)",
      "default": true
    },
    "ctrl_record_security_incident": {
      "type": "boolean",
      "description": "\u5f8c\u8655\u7406\u958b\u95dc\uff1a\u5b89\u5168\u4e8b\u4ef6\u8a18\u9304 (logSecurityEvent)",
      "default": true
    },
    "ctrl_auto_hint_on_idle": {
      "type": "boolean",
      "description": "\u5f8c\u8655\u7406\u958b\u95dc\uff1a\u9592\u7f6e\u81ea\u52d5\u63d0\u793a (triggerAutoHintOnIdle)",
      "default": true
    },
    "prompt_mode": {
      "type": "string",
      "enum": [
        "dynamic",
        "db"
      ],
      "description": "\u63d0\u793a\u8a5e\u6a21\u5f0f\uff1adynamic=\u52d5\u614b\u7d44\u88dd\u5668\u3001db=\u5f9e DB \u8b80\u53d6 SystemPrompt",
      "default": "db"
    }
  },
  "required": []
}